{
  "$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",

  // ═══════════════════════════════════════════════════════════════════════════
  // GameFoo Linter Configuration — CodeStyle Philosophy
  // ═══════════════════════════════════════════════════════════════════════════
  //
  // Design goals: SAFETY, PERFORMANCE, DEVELOPER EXPERIENCE (in that order)
  //
  // Core principles:
  // - Explicit over implicit
  // - Simple control flow
  // - Assert all invariants
  // - No hidden complexity
  // - Names matter
  //
  // "Style is not something to pursue directly. Style is necessary only where
  //  understanding is missing." — Let Over Lambda
  //
  // ═══════════════════════════════════════════════════════════════════════════

  "files": {
    "includes": ["src/**/*.ts", "src/**/*.tsx"]
  },

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },

  // ─── FORMATTER ───────────────────────────────────────────────────────────────
  "formatter": {
    "enabled": true,

    // 2 spaces for indentation (departure from TigerStyle's 4 for readability)
    "indentStyle": "space",
    "indentWidth": 2,

    // Hard limit: 100 columns (TigerStyle: never exceed, no exceptions)
    // "There's a sharp discontinuity between code fitting on screen and scrolling"
    "lineWidth": 100,

    "lineEnding": "lf",
    "bracketSpacing": true,
    "trailingNewline": true,
    "expand": "auto",
    "useEditorconfig": false
  },

  // ─── JAVASCRIPT / TYPESCRIPT ─────────────────────────────────────────────────
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",

      // Always trailing commas (safety: easier to add/remove lines, cleaner diffs)
      "trailingCommas": "all",

      // Always semicolons (explicit over implicit)
      "semicolons": "always",

      // Always parentheses on arrow params (explicit over implicit)
      "arrowParentheses": "always",

      "bracketSameLine": false,
      "operatorLinebreak": "before"
    }
  },

  // ─── LINTER ──────────────────────────────────────────────────────────────────
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,

      // ─── CORRECTNESS: Catch bugs before they ship ──────────────────────────
      "correctness": {
        // Unused code is dead code — remove it or fix it
        "noUnusedVariables": "error",
        "noUnusedImports": "error",

        // Prevent accidental re-assignment of function parameters
        // (reduces cache invalidation bugs)
        "noParameterAssign": "error",

        // Constructor super() must be called before accessing `this`
        "noUnreachableSuper": "error",

        // Switch cases must not fall through accidentally
        "noSwitchDeclarations": "error",

        // Prevent infinite loops without break/return
        "noConstantCondition": "warn",

        // Catch potential null/undefined bugs
        "noUndeclaredVariables": "error",

        // Ensure all code paths return a value when required
        "noUnreachable": "error"
      },

      // ─── STYLE: Explicit, consistent, readable ─────────────────────────────
      "style": {
        // ALLOW non-null assertions — engine code often knows more than TypeScript
        // BUT: use sparingly. Prefer explicit checks where possible.
        "noNonNullAssertion": "off",

        // Require const for variables that are never reassigned
        // (immutability by default reduces cache invalidation)
        "useConst": "error",

        // Use template literals instead of string concatenation
        // (clearer intent, less error-prone)
        "useTemplate": "warn",

        // Require === and !== (explicit, no type coercion)
        "noImplicitBoolean": "error",

        // Single variable declaration per statement
        // (easier to read, debug, and modify)
        "useSingleVarDeclarator": "error",

        // Consistent naming
        "useNamingConvention": "off", // Handled by custom rules below

        // Block statements even for single-line ifs
        // (defense in depth against goto-fail bugs)
        "useBlockStatements": "warn"
      },

      // ─── COMPLEXITY: Simple control flow wins ──────────────────────────────
      "complexity": {
        // ALLOW static-only classes — used for namespacing in game engines
        "noStaticOnlyClass": "off",

        // Forbid excessive boolean complexity
        // "Split compound conditions into simple conditions using nested if/else"
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxComplexity": 15 }
        },

        // Disallow nested ternaries (use if/else for clarity)
        "noNestedTernary": "error",

        // Limit function parameters (too many = function doing too much)
        "noExcessiveComplexity": "warn",

        // Prefer for-of over array methods where appropriate
        "useSimplifiedLogicExpression": "warn"
      },

      // ─── SUSPICIOUS: Catch likely mistakes ─────────────────────────────────
      "suspicious": {
        // ALLOW explicit any — necessary for generic engine internals
        // BUT: use sparingly. Prefer unknown and type guards.
        "noExplicitAny": "off",

        // Catch double equality bugs
        "noDoubleEquals": "error",

        // Empty interfaces are probably mistakes
        "noEmptyInterface": "error",

        // Catch array mutations that might be bugs
        "noConfusingVoidType": "error",

        // Detect redundant use of Boolean/Number/String constructors
        "noRedundantUseStrict": "error",

        // Catch assignments in conditionals (likely typo)
        "noAssignInExpressions": "error",

        // Sparse arrays are confusing
        "noSparseArray": "error",

        // Async without await is suspicious
        "noAsyncPromiseExecutor": "error",

        // Catch shadowed variables (cache invalidation risk)
        "noShadowRestrictedNames": "error"
      },

      // ─── PERFORMANCE: Work with the grain ──────────────────────────────────
      "performance": {
        // Accumulate strings with array.join, not repeated concatenation
        "noAccumulatingSpread": "warn",

        // Delete is slow — use Map instead of objects for dynamic keys
        "noDelete": "warn"
      },

      // ─── NURSERY: Experimental rules we want to enforce ────────────────────
      "nursery": {
        // Enforce consistent array methods
        "noForEach": "off", // Allow forEach — common pattern in game loops

        // Use Number.isNaN instead of isNaN
        "useNumberNamespace": "warn"
      }
    }
  },

  // ─── ASSIST: Safe code actions on save ──────────────────────────────────────
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "recommended": true
      }
    }
  },

  // ─── OVERRIDES: Special rules for specific patterns ─────────────────────────
  "overrides": [
    {
      // Test files can be more lenient
      "include": ["tests/**/*.ts", "**/*.test.ts", "**/*.spec.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      // Type definition files
      "include": ["**/*.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noEmptyInterface": "off"
          }
        }
      }
    }
  ]
}
