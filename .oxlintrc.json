{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "env": {
    "builtin": true,
    "browser": true,
    "node": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "curly": ["error", "all"]
  },
  "ignorePatterns": ["dist", "docs", "node_modules", "**/*.d.ts"]
}
