# 1. Format and lint only staged files.
#    oxfmt rewrites staged files in place; oxlint --fix applies safe fixes.
#    If anything unfixable remains, oxlint exits non-zero and the commit is
#    blocked. lint-staged re-stages the fixed files.
pnpm lint-staged

# 2. Type-check the whole project.
#    TypeScript has no concept of "staged files" — cross-file type inference
#    requires the full source tree to be valid.
pnpm run typecheck
