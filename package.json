{
  "name": "@dryanovski/gamefoo",
  "version": "0.4.0",
  "description": "A lightweight 2D game engine with behavior-based component system",
  "license": "MIT",
  "source": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./source": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && pnpm tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "vp lint src",
    "lint:fix": "vp lint --fix src",
    "format": "vp fmt src",
    "format:check": "vp fmt --check src",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "check:staged": "pnpm lint-staged",
    "prepublishOnly": "pnpm run check && pnpm run build",
    "prepare": "husky",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:publish": "pnpm run --filter publish-test sanity"
  },
  "dependencies": {
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "express": "^4.21.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "oxfmt",
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm"
}
