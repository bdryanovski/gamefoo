{
  "name": "@dryanovski/gamefoo",
  "version": "0.4.0",
  "description": "A lightweight 2D game engine with behavior-based component system",
  "license": "MIT",
  "source": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./source": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "vp lint src",
    "format": "vp fmt src",
    "prepare": "husky",
    "test": "vp test run"
  },
  "dependencies": {
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "express": "^4.21.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "oxfmt",
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm"
}
