      "messages": {
        "msg_mtsn4ael_3o": {
          "title": "Olive",
          "segments": [
            "You pick up the olive carefully.",
            "For some reason, it feels like something that belongs to her."
          ],
          "options": [],
          "meta": {}
        }
      }
    },
    "Olive - remember": {
      "id": "dlg_mtsn5lha_3t",
