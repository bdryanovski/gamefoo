      "root": "msg_mtsn304e_3k",
      "messages": {
        "msg_mtsn304e_3k": {
          "title": "Olive",
          "segments": [
            "You remember her teasing you about olives.",
            "You remember smiling."
          ],
          "options": [],
          "meta": {}
        }
      }
    },
    "Olive - pick up": {
      "id": "dlg_mtsn4ael_3p",
