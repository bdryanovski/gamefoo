    "Olive - not about them": {
      "id": "dlg_mtsm8ho8_2d",
      "name": "Olive - not about them",
      "root": "msg_mtsm8ho8_2c",
      "messages": {
        "msg_mtsm8ho8_2c": {
          "title": "Olive ",
          "segments": [
            "You finally understand why you kept looking.",
            "It was never about the olives."
          ],
          "options": [],
          "meta": {}
        }
      }
    },
    "Olive - the last one is close": {
      "id": "dlg_mtsm96o9_2h",
      "name": "Olive - the last one is close",
      "root": "msg_mtsm96o9_2g",
      "messages": {
        "msg_mtsm96o9_2g": {
          "title": "Olive",
          "segments": [
            "Where is the last one ?",
            "You already know where it is right ?"
          ],
          "options": [],
          "meta": {}
        }
      }
    },
    "Olive - last one": {
      "id": "dlg_mtsma4mm_2l",
      "name": "Olive - last one",
      "root": "msg_mtsma4mm_2k",
      "messages": {
        "msg_mtsma4mm_2k": {
          "title": "Olive",
          "segments": [
            "The last olive is waiting beside the fire.",
            "You pick it up.",
            "Nothing happens.",
            "And somehow, that hurts more than if something had."
          ],
          "options": [],
          "meta": {}
        }
      }
    },
    "Olive - part of her": {
      "id": "dlg_mtsmtd69_2p",
      "name": "Olive - part of her",
      "root": "msg_mtsmtd69_2o",
      "messages": {
        "msg_mtsmtd69_2o": {
          "title": "Olive",
          "segments": [
            "Now even an olive feels like a piece of her."
          ],
          "options": [],
          "meta": {}
        }
      }
    },
    "Olive - small one": {
      "id": "dlg_mtsmy7qb_35",
      "name": "Olive - small one",
      "root": "msg_mtsmy7qb_34",
      "messages": {
        "msg_mtsmy7qb_34": {
          "title": "Olive ",
          "segments": [
            "The olive is small enough to disappear in your palm.",
            "Somehow, you don’t want to let it go."
          ],
          "options": [],
          "meta": {}
        }
      }
    },
    "Olive - holding": {
      "id": "dlg_mtsmvb26_2x",
      "name": "Olive - holding",
      "root": "msg_mtsmvb26_2w",
      "messages": {
        "msg_mtsmvb26_2w": {
          "title": "Olive",
          "segments": [
            "You close your hand around the olive.",
            "For a moment, it almost feels like holding onto her."
          ],
          "options": [],
          "meta": {}
        }
      }
    },
    "Olive - memmory": {
      "id": "dlg_mtsmwmks_31",
      "name": "Olive - memmory",
      "root": "msg_mtsmwmks_30",
      "messages": {
        "msg_mtsmwmks_30": {
          "title": "Olive",
          "segments": [
            "She once told you that everything could become a memory.",
            "You didn’t believe her.",
            "Now you collect olives - you are that kind of person now!"
          ],
          "options": [],
          "meta": {}
        }
      }
    },
    "Olive - not a treasure ": {
      "id": "dlg_mtsmzasg_39",
      "name": "Olive - not a treasure ",
      "root": "msg_mtsmzasg_38",
      "messages": {
        "msg_mtsmzasg_38": {
          "title": "Olive",
          "segments": [
            "You look around the room.",
            "For the first time, you aren’t searching for treasure."
          ],
          "options": [],
          "meta": {}
        }
      }
    },
    "Olive and the love": {
      "id": "dlg_mtsn0uer_3d",
      "name": "Olive and the love",
      "root": "msg_mtsn0uer_3c",
      "messages": {
        "msg_mtsn0uer_3c": {
          "title": "Olive ",
          "segments": [
            "Maybe love is remembering things that should have been forgettable."
          ],
          "options": [],
          "meta": {}
        }
      }
    },
    "Olive - too much ?": {
      "id": "dlg_mtsn1xxf_3h",
      "name": "Olive - too much ?",
      "root": "msg_mtsn1xxf_3g",
      "messages": {
        "msg_mtsn1xxf_3g": {
          "title": "Olive",
          "segments": [
            "You wonder if she would still call thirty olives unreasonable.",
            "You suspect she would."
          ],
          "options": [],
          "meta": {}
        }
      }
    },
    "Olive - tease": {
      "id": "dlg_mtsn304e_3l",
