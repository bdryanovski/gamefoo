# EditorConfig — https://editorconfig.org
# This is the root config; editors stop searching at this file.
root = true

# ── Defaults for all files ────────────────────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# ── TypeScript / TSX ─────────────────────────────────────────────────────────
# Matches biome.jsonc: 2-space indent, LF, trailing newline
[*.{ts,tsx}]
indent_style = space
indent_size = 2

# ── JSON / JSONC ──────────────────────────────────────────────────────────────
[*.{json,jsonc}]
indent_style = space
indent_size = 2

# ── Markdown ──────────────────────────────────────────────────────────────────
# Trailing whitespace is significant in Markdown (line breaks)
[*.md]
trim_trailing_whitespace = false

# ── Shell scripts ─────────────────────────────────────────────────────────────
[*.sh]
indent_style = tab
