{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "outDir": "dist"
  },
  "include": [
    "src/index.ts",
    "src/core/**/*.ts",
    "src/entities/**/*.ts",
    "src/types.ts"
  ],
  "exclude": [
    "demo",
    "node_modules",
    "dist"
  ]
}
